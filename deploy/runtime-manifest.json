{
  "schema_version": 1,
  "profile": "colab-native",
  "description": "Pinned native artifacts for the colab-native / local-native runner. Checksum values are null until verified values are committed (decision D-ENV-05): bootstrap fetches the publisher's official checksum from the same origin as the archive and records VERIFIED only in W/runtime/bootstrap_report.json. Run `prepare_runtime.py --emit-pin-patch` after a successful bootstrap to obtain values to review and commit. Exception: cloudflared publishes its sha256 only in the release notes, so that value is committed (status PINNED) and is the sole reference.",
  "platform": {"os": "linux", "arch": "x86_64", "libc": "glibc"},
  "checksum_policy": {
    "algorithms": ["sha256", "sha512"],
    "sources": "publisher-official-only",
    "require_pinned": false,
    "on_mismatch": "fail",
    "on_unavailable": "fail"
  },
  "python": {
    "version_file": ".python-version",
    "minor": "3.11",
    "lock": {"file": "uv.lock", "sha256": null, "status": "NOT_GENERATED"}
