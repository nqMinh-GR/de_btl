      "checksum": {"algorithm": "sha256", "value": null, "official_source": "<url>.sha256", "format": "sha256sum"},
      "install_to": "tools/uv/0.12.23",
      "probe": ["uv", "--version"],
      "expect": "uv 0.12.23",
