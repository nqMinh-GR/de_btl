# Example configuration only. No credentials are needed: MBTA feeds are public.
# Copy to .env (gitignored) if you want to override defaults locally.
TP_PROFILE=local-native
TP_WORKDIR=./.runtime
# Comma-separated, verified bus route IDs from `make list-routes` (no random fallback).
TP_ROUTE_IDS=
TP_KAFKA_BOOTSTRAP=127.0.0.1:9092
TP_CASSANDRA_HOSTS=127.0.0.1
TP_API_URL=http://127.0.0.1:8000/api/v1
